    "test:debug": "HEADLESS=false playwright test tests/login/login.spec.js --debug",
    "test:trace": "TRACE=on playwright test tests/login/login.spec.js",
    "test:video": "VIDEO=on playwright test tests/login/login.spec.js",
    "report": "playwright show-report reports/html",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:login-data": "node scripts/generateLoginData.js",
    "generate:partner-data": "node scripts/generatePartnerData.js",
    "generate:purchase-data": "node scripts/generatePurchaseData.js",
