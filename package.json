    "allure:clean": "node scripts/clean-allure.js",
    "test:login": "playwright test tests/login/login.spec.js",
    "test:smoke": "playwright test tests/login/login.spec.js --grep @smoke",
    "test:sanity": "playwright test tests/login/login.spec.js --grep @sanity",
    "test:regression": "playwright test tests/login/login.spec.js --grep @regression",
    "test:data-driven": "playwright test tests/login/login.spec.js --grep @data-driven",
