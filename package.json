{
  "name": "hi-busy-automation",
  "version": "1.0.0",
  "description": "Enterprise Playwright JavaScript Automation Framework for Hi Busy Subscription Management System",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/test-with-allure.js",
    "test:playwright": "playwright test",
    "test:allure": "node scripts/test-with-allure.js",
    "test:report": "node scripts/runAndReport.js",
