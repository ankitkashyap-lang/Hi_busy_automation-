# Hi Busy Automation Framework — Environment Configuration
# Copy this file to .env and update with your values
# DO NOT commit .env with real credentials

# ========================
# APPLICATION CONFIGURATION
# ========================

# Environment name: dev, qa, stage, prod
ENVIRONMENT=qa

# Base URL for the application
BASE_URL=https://hiqa2.pooraa.net/

# QA Environments (Used by QA Runner)
QA1_BASE_URL=https://hiqa1.pooraa.net/
QA2_BASE_URL=https://hiqa2.pooraa.net/

# Email Recipients for QA Reports
QA1_REPORT_EMAIL=qa-team@example.com
QA2_REPORT_EMAIL=qa-team@example.com

# Surge.sh Domains for Allure Reports (must end in .surge.sh)
SURGE_DOMAIN=busy-playwright-allure.surge.sh
SURGE_QA1_DOMAIN=busy-qa1-automation-report.surge.sh
SURGE_QA2_DOMAIN=busy-qa2-automation-report.surge.sh

# Surge Authentication (Optional if already logged in locally via 'npx surge login')
# In CI/CD pipelines or automated environments, set SURGE_LOGIN and SURGE_TOKEN
SURGE_LOGIN=your_surge_email@example.com
SURGE_TOKEN=your_surge_token

# (Optional) Deploy Playwright HTML report to a separate Surge domain.
# If set, the email will include a second "Playwright HTML Report" button.
# SURGE_PW_HTML_DOMAIN=busy-pw-html-report.surge.sh


# ========================
# BROWSER CONFIGURATION
# ========================

# Browser to run tests: chromium, firefox, webkit
BROWSER=chromium

# Run in headless mode: true, false
HEADLESS=true

# ========================
# TEST EXECUTION
# ========================

# Number of parallel workers
WORKERS=10

# Enable video recording: on, off
VIDEO=off

# Enable trace recording: on, off
TRACE=off

# Enable screenshot on failure: on, off
SCREENSHOT=on

# Test timeout in milliseconds
TIMEOUT=30000

# Navigation timeout in milliseconds
NAVIGATION_TIMEOUT=30000

# Action timeout in milliseconds
ACTION_TIMEOUT=10000

# ========================
# LOGGING & REPORTING
# ========================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log directory
LOG_DIR=logs

# Report format: html, json, allure
REPORT_FORMAT=html

# Reports directory
REPORT_DIR=reports

# ========================
# TEST DATA
# ========================

# Excel test data file location
TEST_DATA_FILE=test-data/LoginData.xlsx

# Test data execute flag: Yes, No
TEST_DATA_EXECUTE=Yes

# Test data priority filter: P0, P1, P2, P3, all
TEST_DATA_PRIORITY=all

# ========================
# DATABASE (Optional)
# ========================

# Database type: mysql, postgres, none
DB_TYPE=none

# Database host
DB_HOST=localhost

# Database port
DB_PORT=3306

# Database name
DB_NAME=

# Database user
DB_USER=

# Database password
DB_PASSWORD=

# ========================
# API TESTING (Optional)
# ========================

# API base URL
API_BASE_URL=https://api.hiqa2.pooraa.net/

# API timeout in milliseconds
API_TIMEOUT=10000

# ========================
# NOTIFICATIONS (Optional)
# ========================

# Send email notifications: true, false
SEND_EMAIL_NOTIFICATIONS=false

# Email recipients (comma-separated)
EMAIL_RECIPIENTS=qa-team@example.com

# SMTP server
SMTP_SERVER=

# SMTP port
SMTP_PORT=587

# SMTP user
SMTP_USER=

# SMTP password
SMTP_PASSWORD=

# ========================
# TEST USER CREDENTIALS
# ========================

# Admin user
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# Busy Team user
BUSY_TEAM_EMAIL=busy_team@example.com
BUSY_TEAM_PASSWORD=your_busy_team_password

# Channel Partner user
CHANNEL_PARTNER_EMAIL=partner@example.com
CHANNEL_PARTNER_PASSWORD=your_partner_password

# Reseller user (if available)
RESELLER_EMAIL=reseller@example.com
RESELLER_PASSWORD=your_reseller_password

# ========================
# CI/CD CONFIGURATION
# ========================

# CI/CD platform: github, gitlab, azure, jenkins, none
CI_PLATFORM=none

# Build number
BUILD_NUMBER=

# Branch name
BRANCH_NAME=main

# Commit SHA
COMMIT_SHA=

# ========================
# DEBUG & ADVANCED
# ========================

# Enable debug mode: true, false
DEBUG=false

# Slow down execution (milliseconds) for visual debugging
SLOW_MO=0

# Retry count for failed tests
RETRY_COUNT=0

# Workers for parallel execution
WORKERS=1

# ========================
# NOTES
# ========================
# - Credentials are required only for test users
# - Database config only needed for backend validation tests
# - API config only needed for hybrid automation tests
# - Notifications only needed for CI/CD integration
# - DO NOT commit real credentials to Git
# - Use GitHub Secrets or approved secret managers in CI/CD
