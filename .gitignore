# ==========================================
# Environment & Secrets (NEVER COMMIT)
# ==========================================
.env
.env.local
.env.*.local
*.pem
*.key

# ==========================================
# Dependencies & Package Managers
# ==========================================
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

